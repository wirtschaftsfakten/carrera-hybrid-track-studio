# Copy to server/.env and fill in. Never commit the real file.
PORT=8787
# Origins of the web app / PWA / Capacitor app that may call the API
ALLOWED_ORIGINS=https://example.com,capacitor://localhost,http://localhost:5173
# Created by: npm run server:keys
ENTITLEMENT_PRIVATE_KEY_FILE=server/data/entitlement-private.pem

# Stripe (Dashboard > Developers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Apple (App Store Connect)
APPLE_BUNDLE_ID=
APPLE_PRODUCT_IDS=trackstudio.pro.monthly,trackstudio.pro.yearly
# DER file from https://www.apple.com/certificateauthority/AppleRootCA-G3.cer
APPLE_ROOT_CA_G3_FILE=server/data/AppleRootCA-G3.cer
APPLE_ENVIRONMENTS=Production,Sandbox
